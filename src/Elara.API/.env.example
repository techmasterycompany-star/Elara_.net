# ===========================================
# Elara E-Commerce API - Environment Variables Example
# ===========================================
# Copy this file to .env and fill in your actual values
# This file CAN be committed to git
# ===========================================

# -------------------------------------------
# Database Connection
# -------------------------------------------
ConnectionStrings__DefaultConnection=Server=localhost;Database=Elara;Trusted_Connection=True;TrustServerCertificate=True;

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
Jwt__Key=your-super-secret-key-at-least-32-characters-long-for-hmac-sha256
Jwt__Issuer=Elara
Jwt__Audience=Elara
Jwt__DurationInMinutes=60

# -------------------------------------------
# Stripe Payment Gateway
# -------------------------------------------
Stripe__SecretKey=
Stripe__PublishableKey=
Stripe__WebhookSecret=

# -------------------------------------------
# PayPal Payment Gateway
# -------------------------------------------
PayPal__ClientId=
PayPal__ClientSecret=
PayPal__BaseUrl=https://api-m.sandbox.paypal.com

# -------------------------------------------
# Cloudinary (Image Storage)
# -------------------------------------------
Cloudinary__CloudName=
Cloudinary__ApiKey=
Cloudinary__ApiSecret=

# -------------------------------------------
# Email (SMTP)
# -------------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__From=

# -------------------------------------------
# Google OAuth
# -------------------------------------------
Google__ClientId=
Google__ClientSecret=

# -------------------------------------------
# Client URL
# -------------------------------------------
ClientUrl=https://localhost:7121

# -------------------------------------------
# Logging
# -------------------------------------------
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft=Warning